<!-- ============================================================
     detail.ejs — Single-book view with full notes
     Receives: book (object with .cover attached)
     ============================================================ -->
<%- include("partials/header") %>

<main class="container container--narrow">

  <a href="/" class="back-link">← Back to all books</a>

  <article class="detail">

    <!-- Cover + quick facts -->
    <div class="detail__top">
      <img
        class="detail__cover"
        src="<%= book.cover %>"
        alt="Cover of <%= book.title %>"
      />

      <div class="detail__info">
        <h1 class="detail__title"><%= book.title %></h1>
        <p class="detail__author">by <%= book.author %></p>

        <% if (book.rating) { %>
          <div class="detail__rating">
            <span class="detail__rating-num"><%= book.rating %></span>
            <span class="detail__rating-max">/10</span>
          </div>
        <% } %>

        <% if (book.date_read) { %>
          <p class="detail__date">
            Read <%= new Date(book.date_read).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }) %>
          </p>
        <% } %>

        <% if (book.isbn) { %>
          <p class="detail__isbn">ISBN: <%= book.isbn %></p>
        <% } %>

        <div class="detail__actions">
          <a href="/edit/<%= book.id %>" class="btn btn--primary btn--small">Edit</a>
          <form action="/delete/<%= book.id %>" method="POST" class="inline-form"
                onsubmit="return confirm('Delete this book?')">
            <button type="submit" class="btn btn--danger btn--small">Delete</button>
          </form>
        </div>
      </div>
    </div>

    <!-- Full notes -->
    <% if (book.notes) { %>
      <section class="detail__notes">
        <h2 class="detail__notes-heading">My Notes</h2>
        <!-- Preserve line breaks in the notes text -->
        <div class="detail__notes-body">
          <%= book.notes %>
        </div>
      </section>
    <% } %>

  </article>

</main>

<%- include("partials/footer") %>
