<!-- ============================================================
     edit.ejs — Edit an existing book
     Receives: book (object), error (string|null)
     ============================================================ -->
<%- include("partials/header") %>

<main class="container container--narrow">
  <header class="page-header">
    <h1 class="page-header__title">Edit Book</h1>
    <p class="page-header__subtitle">Update your notes for "<%= book.title %>"</p>
  </header>

  <% if (error) { %>
    <div class="alert alert--error"><%= error %></div>
  <% } %>

  <section class="form-card">
    <form action="/edit/<%= book.id %>" method="POST" class="book-form" novalidate>

      <div class="field">
        <label for="title" class="field__label">Title *</label>
        <input id="title" name="title" type="text" class="field__input" required
               value="<%= book.title %>" />
      </div>

      <div class="field">
        <label for="author" class="field__label">Author *</label>
        <input id="author" name="author" type="text" class="field__input" required
               value="<%= book.author %>" />
      </div>

      <div class="field">
        <label for="isbn" class="field__label">ISBN</label>
        <input id="isbn" name="isbn" type="text" class="field__input"
               placeholder="e.g. 0735211299"
               value="<%= book.isbn || '' %>" />
        <p class="field__hint">
          Find the ISBN on the book's back cover or
          <a href="https://openlibrary.org" target="_blank">openlibrary.org</a>.
        </p>
      </div>

      <div class="field">
        <label for="rating" class="field__label">Rating (1–10)</label>
        <input id="rating" name="rating" type="number" min="1" max="10"
               class="field__input field__input--short"
               value="<%= book.rating || '' %>" />
      </div>

      <div class="field">
        <label for="date_read" class="field__label">Date Read</label>
        <%
          // Format the existing date for the date input (YYYY-MM-DD)
          let dateVal = "";
          if (book.date_read) {
            const d = new Date(book.date_read);
            dateVal = d.toISOString().split("T")[0];
          }
        %>
        <input id="date_read" name="date_read" type="date"
               class="field__input field__input--short"
               value="<%= dateVal %>" />
      </div>

      <div class="field">
        <label for="notes" class="field__label">Notes</label>
        <textarea id="notes" name="notes" rows="8"
                  class="field__textarea"><%= book.notes || '' %></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn--primary">Update Book</button>
        <a href="/" class="btn btn--ghost">Cancel</a>
      </div>

    </form>
  </section>
</main>

<%- include("partials/footer") %>
